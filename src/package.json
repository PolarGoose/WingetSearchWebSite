{
  "name": "WingetSearchWebSite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "prettier -w . && tsc --build create-winget-packages-sqlite-db web-site && node create-winget-packages-sqlite-db/src/index.ts && vite build --emptyOutDir web-site",
    "web:debug": "vite web-site",
    "db:debug": "node --inspect-brk create-winget-packages-sqlite-db/src/index.ts"
  },
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "@sqlite.org/sqlite-wasm": "latest",
    "better-sqlite3": "latest",
    "dayjs": "latest",
    "execa": "latest",
    "fast-glob": "latest",
    "prettier": "latest",
    "react": "latest",
    "react-dom": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
