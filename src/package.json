    "better-sqlite3": "^12.9.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
